      "exact_flow": [
        "require this.PlObj.Zone raw 9; otherwise return false",
        "if this.PlObj.State is raw 22 return false; every other raw State continues",
        "write raw false to this.isThrowOppopnentToRope",
        "if this.PlObj.isPinfallDef is true write raw 32 to inherited padOn and return false",
        "if this.PlObj.isIntruder is true call canonical FACT-0109 PlayerMan.GetPlObj(this.PlObj.TargetPlIdx) and store Player local0",
        "on the intruder path, if local0.Zone is raw 9 or raw 10 return false",
        "on every remaining intruder path load this.PlObj.PlPos.y then this.PlObj.PlPos.x and execute raw ble.un; target writes raw 4 to padOn, fallthrough writes raw 2; return true",
        "on the non-intruder path perform the same raw PlPos.y then PlPos.x ble.un selection; target writes raw 4 to padOn, fallthrough writes raw 2; return true"
      ]
    },
