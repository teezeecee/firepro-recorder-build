    "raw_control_flow": {
      "clear_table": "local0 starts at 0; IL+0x0007..0x0013 writes false to rapidPushTbl[local0], increments local0, and IL+0x0017 loops while local0 < 60.",
      "rate_selection": "MatchSetting and COMLevelData are loaded into locals 1 and 2; MatchRandom.Range receives pushButtonNumPerSecond_Min and pushButtonNumPerSecond_Max + 1 and its Int32 result is stored to rapidPushRate.",
      "rate_gates": "IL+0x0058 bgt enters the continuing path only when rapidPushRate > 0; otherwise rapidPushRate is written as 0 and the method returns at IL+0x0064. IL+0x006D ble skips the raw-60 clamp when rapidPushRate <= 60; otherwise rapidPushRate is written as 60.",
      "interval_build": "local3 receives 60 / rapidPushRate and local4 receives 60 % rapidPushRate. local5 fills itv_tbl[0..rapidPushRate-1] with local3. local6 then increments itv_tbl[0..local4-1] by one through ldelema System.Int32 and stind.i4.",
      "shuffle": "Misc.Shuffle(itv_tbl, rapidPushRate) is called at IL+0x00E9.",
      "output_build": "locals7 and 8 start at zero. For each local8 < rapidPushRate, local7 adds itv_tbl[local8], is capped to raw 60 when greater than 60, and rapidPushTbl[local7 - 1] is written true; local8 then increments."
    },
