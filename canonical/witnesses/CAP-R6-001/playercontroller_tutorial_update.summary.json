      "exact_flow": [
        "write raw 0 to inherited padOn and padPush",
        "if plObj.Zone is nonzero: call Player.Start_ForceControl(raw 4), then branch to Process_Grapple",
        "if plObj.Zone is zero: call Player.End_ForceControl",
        "compare PlPos.x to HomePos.x + 0.1f; when greater and ordered, OR raw 4 into padOn",
        "compare PlPos.x to HomePos.x - 0.1f; when less and ordered, OR raw 8 into padOn",
        "compare PlPos.y to HomePos.y + 0.1f; when greater and ordered, OR raw 2 into padOn",
        "compare PlPos.y to HomePos.y - 0.1f; when less and ordered, OR raw 1 into padOn",
        "call Process_Grapple",
        "if isPinfallDef: call mRate100Check(raw 30); when true write raw 32 to padPush; then write raw 32 to padOn",
        "if isSubmissionDef: call mRate100Check(raw 30); when true write raw 8 to padPush",
        "return"
      ]
    },
