    "exact_control_blocks": [
      {
        "range": "IL+0x0000..0x000C",
        "effect": "If Match_Disconnect_Myself is nonzero, return true; otherwise continue."
      },
      {
        "range": "IL+0x000D..0x0020",
        "effect": "Call FACT-0215 Network_OnlineCheck. Raw zero enters the disconnect-all path. Nonzero then calls external get_internetReachability; raw zero enters the same path and nonzero branches to IL+0x00D5."
      },
      {
        "range": "IL+0x0021..0x00D4",
        "effect": "For every raw player index below m_MaxPlayerNum write AsynchronousTime[index]=10.0 and isAsynchronous_Timeout[index]=true; for non-self indices find a Player through FACT-0219/FACT-0217 and, when non-null, call FACT-0218 with raw selector 2. Select one of two fixed disconnect messages by raw language zero/nonzero, call FACT-0216 with duration 240, set Match_Disconnect_Myself and Match_Disconnect true, return false."
      },
      {
        "range": "IL+0x00D5..0x00E8",
        "effect": "If m_InputBuffer is null, set Match_Disconnect true and return false; otherwise continue with result local initialized true."
      },
      {
        "range": "IL+0x00E9..0x021A",
        "effect": "Scan all non-self indices below m_MaxPlayerNum, skipping entries whose timeout byte is nonzero. A nonzero m_InputBuffer[index].Count resets AsynchronousTime[index] to 0. A zero Count sets the result local false, adds external deltaTime to AsynchronousTime[index], and only when the accumulated value is greater than raw 10.0 sets timeout true, looks up the Player, applies raw controller selector 2 when non-null, shows a username-bearing 240-duration message chosen by raw language zero/nonzero, and sets Match_Disconnect true."
      },
      {
        "range": "IL+0x021F..0x025A",
        "effect": "If Match_Disconnect is nonzero or the result local is false, return the result local. Otherwise clear every AsynchronousTime entry to 0 and return the result local (true)."
      }
    ],
