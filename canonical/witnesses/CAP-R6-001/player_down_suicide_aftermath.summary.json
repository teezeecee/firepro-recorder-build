        "local0 = MatchData.mHpDamageTbl[MatchMisc.GetHealth(HP) / 2]",
        "local1 = MatchData.mFailureDamageRateTbl[WresParam.fightStyle]"
      ],
      "hp_path": [
        "local2 = Float32(CurrentSkill.suicideDamage_HP) * local0 * local1 * 256.0f",
        "AddHP(-local2)",
