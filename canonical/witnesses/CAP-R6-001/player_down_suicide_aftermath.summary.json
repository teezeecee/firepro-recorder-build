    "calc_down_time": {
      "entry": [
        "venue = Ring.inst.venueSetting",
        "if isStandingStunOK == 0: SetStunTime(0)",
        "if DownTime != 0 or isDisableUpdateDownTime != 0: skip primary calculation"
      ],
      "primary_scalar": "local1 = LastDamage + 65535.0f - HP",
      "standing_branch": [
        "if local1 > 49151.0f: local2 = Int32((local1 - 32767.0f) / 256.0f); cap local2 at 127; SetStunTime(local2); local1 = 40959.0f",
        "else preserve local1"
      ],
      "nonstanding_branch": "if local1 > 65535.0f: local1 = 65535.0f",
      "primary_down_time": "SetDownTime(Int32(local1 / 256.0f))",
      "ring_kind_2_branch": [
        "venue.ringKind == 2",
        "GetParamRate(HP) <= 0.4000000059604645f",
        "GetParamRate(SP) <= 0.4000000059604645f",
        "if StunTime != 0: SetStunTime(960); else SetDownTime(1200)"
      ],
      "post_primary": [
        "isDisableUpdateDownTime = 1",
        "if (spSkillFlags & 2) != 0 AND HP > 3072.0f AND HP < 13056.0f AND SP > 39168.0f: SetDownTime(DownTime / 8)",
        "if MatchSetting.is10CountKO != 0 AND HP >= 32768.0f: SetDownTime(0)",
        "if MatchSetting.isS1Rule != 0 AND isS1MoveRecieved == 0: SetDownTime(0)"
      ],
      "exact_helpers": {
