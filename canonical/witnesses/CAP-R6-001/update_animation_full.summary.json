    "entry_and_init": [
      "target = PlayerMan.inst.GetPlObj(plObj.TargetPlIdx)",
      "if isAnmPause != 0: return",
      "plObj.ProcessFoxSleep()",
      "if reqAnmInit != 0: InitAnimation(); reqAnmInit = 0",
      "if CurrentSkill is null: return",
      "if CurrentSkill.anmData[CurrentAnmIdx] is null: return",
      "local anmData = CurrentSkill.anmData[CurrentAnmIdx]"
    ],
    "loop_boundary": [
      "if FormDispDuration > 0: skip loop-boundary test",
      "if currentFormIdx < anmData.formNum - 1: skip loop-boundary test",
      "status = PlayerStatusDataMan.GetPlayerStatusData(plObj.State)",
      "if status.anmLoop == 0: return",
      "currentFormIdx = -1"
    ],
    "form_advance": [
      "isAnmSync = 1",
      "only when FormDispDuration == 0: ProcessAnmLoop()",
      "candidate = currentFormIdx + 1",
      "while candidate < anmData.formNum: if anmData.formDispList[candidate].dispFrm != 0 then currentFormIdx = candidate and stop scanning; otherwise candidate += 1",
      "info = GetCurrentFormDispInfo()",
      "FormDispDuration = info.dispFrm + FrameWait",
      "x = info.centerPos.x; y = -info.centerPos.y",
      "if plObj.PlDir >= 3: x = -x",
      "plObj.PlPos.x += x * 0.0208333320915699f",
      "plObj.PlPos.y += y * 0.0208333320915699f",
      "FormRev = info.flags",
      "PlayAnimationSE()"
    ],
    "form_flags": [
      {
        "mask": 4,
        "effect": "AnmHostPlayer = plObj.PlIdx"
      },
      {
        "mask": 32,
        "effect": "MatchMisc.ApplyDamage(plObj.PlIdx, plObj.TargetPlIdx); if target Player converts true: target.CalcDownTime()"
      },
      {
        "mask": 16,
        "effect": "plObj.plCont_AI.EndPriAct(); plObj.ApplySuicideDamage(); plObj.CalcDownTime()"
      }
    ],
    "ring_and_cheer": [
      "if Ring.inst != null: local bool isOutside = 0; if plObj.Zone != 1 then isOutside = 1; Ring.ShakeRing((float)info.ringVibration, isOutside, plObj.PlPos)",
      "plObj.ControlCheerSE()"
    ],
    "timer_tail": [
      "if AnmStopTimer != 0: AnmStopTimer -= 1",
      "else: FormDispDuration -= 1",
      "return"
    ],
