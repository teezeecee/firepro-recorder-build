      "local5 = MatchMisc.LotOption(local4)",
      "local6 = raw Int32 384",
      "switch local5: raw 0,1,2 -> first branch; raw 3,4,5,6 -> second branch; default -> final true return",
      "first branch: if local1.ringKind equals raw 3, call SetAIAct_Counter(prm_tbl_counter[local5],local6); otherwise call SetAIAct_RunAttackAfterHammerThrow(prm_tbl_run_atk[local5],local6)",
