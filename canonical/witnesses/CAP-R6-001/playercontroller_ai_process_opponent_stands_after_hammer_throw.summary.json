      "local0 = PlayerMan.inst.GetPlObj(this.PlObj.TargetPlIdx)",
      "local1 = Ring.inst.venueSetting",
      "local2 = this.PlObj.WresParam.aiParam",
      "if this.PlObj.Zone is nonzero: return false",
