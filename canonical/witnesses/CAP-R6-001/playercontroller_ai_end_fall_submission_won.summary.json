      "exact_flow": [
        "load PlayerMan.inst; call canonical FACT-0109 PlayerMan.GetPlObj(this.PlObj.TargetPlIdx); store returned Player in local0",
        "pass local0 through external UnityEngine.Object.op_Implicit; if false return false",
        "if this.PlObj.isPinfallAtk is true continue to target-result gates",
        "otherwise require this.PlObj.isSubmissionAtk true; if false write raw -1 to endFallTimer and return false",
        "target-result gates accept local0.isLose true or, when isLose is false, local0.isKO true",
        "if both local0.isLose and local0.isKO are false, write raw -1 to endFallTimer and return false",
        "if endFallTimer is below raw 0, write raw 60 to endFallTimer and return false",
        "otherwise decrement endFallTimer by raw 1 and store the decremented value in both local1 and endFallTimer",
        "if local1 is greater than raw 0 return false",
        "when local1 is <= raw 0 write raw -1 to endFallTimer, raw 32 to inherited padPush, and return true"
      ]
    },
